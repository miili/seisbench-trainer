{
  "data": {
    "datasets": [
      {
        "type": "seisbench",
        "name": "BohemiaSaxony"
      }
    ],
    "component_order": "ENZ",
    "sampling_rate": 100.0,
    "batch_size": 1024,
    "num_workers": 16
  },
  "model": {
    "type": "PhaseNet",
    "pretrained": "original"
  },
  "augmentation": {
    "train": [
      {
        "type": "pick_window",
        "probability": 0.667,
        "length_s": 60.0,
        "before_s": 30.0
      },
      {
        "type": "random_window"
      }
    ],
    "label_sigma_s": 0.1
  },
  "training": {
    "epochs": 100,
    "accelerator": "gpu",
    "optimizer": {
      "type": "adam",
      "lr": 0.01,
      "weight_decay": 0.0
    },
    "monitor": "det/f1_mean"
  },
  "tracking": {
    "tags": {
      "purpose": "final_training"
    }
  },
  "evaluation": {
    "test_at_end": true
  }
}
